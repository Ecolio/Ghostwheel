{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WeatherData v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["city", "days"],
  "properties": {
    "city": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "days": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "tmin", "tmax", "summary", "rainProbability", "windKmh"],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "format": "date"
          },
          "tmin": {
            "type": "integer",
            "minimum": -60,
            "maximum": 60
          },
          "tmax": {
            "type": "integer",
            "minimum": -60,
            "maximum": 60
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "rainProbability": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "windKmh": {
            "type": "integer",
            "minimum": 0,
            "maximum": 300
          }
        }
      }
    }
  }
}
