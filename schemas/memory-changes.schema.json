{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cornelius MemoryChangesProposal v1",
  "description": "Propositions après conversation. Le serveur impose le profil et vérifie preuves, versions et règles métier avant toute écriture.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "changes"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "changes": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "memoryId", "topic", "fact", "evidenceTurnIds", "scope", "expiresAt"],
        "properties": {
          "operation": { "type": "string", "enum": ["add", "update", "forget"] },
          "memoryId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
          "topic": { "type": "string", "minLength": 1, "maxLength": 80 },
          "fact": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
          "evidenceTurnIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "scope": { "type": "string", "enum": ["durable", "temporary"] },
          "expiresAt": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    }
  }
}
